# Dockerfile for midas-wallet-rpc
# Multistage build - requires docker 17.05+

# builder stage
FROM ubuntu:20.04 AS builder

RUN set -ex && \
    apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get --no-install-recommends --yes install \
        build-essential \
        ca-certificates \
        cmake \
        curl \
        git \
        pkg-config

WORKDIR /src
COPY . .

ARG NPROC
RUN set -ex && \
    git submodule init && git submodule update && \
    rm -rf build && \
    if [ -z "$NPROC" ] ; \
    then make -j$(nproc) depends target=x86_64-linux-gnu ; \
    else make -j$NPROC depends target=x86_64-linux-gnu ; \
    fi

# runtime stage
FROM ubuntu:20.04

RUN set -ex && \
    apt-get update && \
    apt-get --no-install-recommends --yes install ca-certificates && \
    apt-get clean && \
    rm -rf /var/lib/apt

# Copy only wallet binaries (not midasd)
COPY --from=builder /src/build/x86_64-linux-gnu/release/bin/midas-wallet-cli /usr/local/bin/midas-wallet-cli
COPY --from=builder /src/build/x86_64-linux-gnu/release/bin/midas-wallet-rpc /usr/local/bin/midas-wallet-rpc

# Create midas user
RUN adduser --system --group --disabled-password --uid 1000 midas && \
    mkdir -p /data && \
    chown -R midas:midas /data

VOLUME /data

USER midas

ENTRYPOINT ["/bin/sh", "-c"]
CMD ["midas-wallet-cli --help"]
